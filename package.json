{
  "name": "pi-tower",
  "version": "0.3.0",
  "description": "Droid-style Missions for the pi coding agent, run in parallel: /mission plans milestones of features with you, a swarm of workers builds the features of each milestone at the same time in isolated git worktrees, independent reviewers gate every merge, and validators check every milestone until the plan passes. Orchestrator, worker, reviewer and validator models are configured separately. Built on a port of Kimi Code's Tower multi-agent mode.",
  "type": "module",
  "license": "MIT",
  "author": "YukoOshima",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "multi-agent",
    "missions",
    "agent-swarm",
    "tower",
    "orchestrator",
    "git-worktree",
    "code-review",
    "kimi-code"
  ],
  "homepage": "https://github.com/YukoOshima/pi-tower#readme",
  "bugs": {
    "url": "https://github.com/YukoOshima/pi-tower/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YukoOshima/pi-tower.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-tower": "bin/pi-tower.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e:pi": "node --experimental-strip-types --no-warnings test/run-pi-e2e.ts"
  },
  "dependencies": {
    "picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^24.10.0",
    "@types/picomatch": "^4.0.2",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
